# ---------- Postgres ----------
POSTGRES_USER=sendwhats
POSTGRES_PASSWORD=sendwhats
POSTGRES_DB=sendwhats
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sendwhats:sendwhats@localhost:5432/sendwhats?schema=public

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- API ----------
NODE_ENV=development
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Bootstrap super admin (created by `npm run seed`)
SUPER_ADMIN_EMAIL=admin@sendwhats.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ---------- Evolution API (self-hosted, already running) ----------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-global-evolution-api-key
# Public URL this platform is reachable at, used when registering Evolution webhooks
PUBLIC_API_URL=http://localhost:4000

# ---------- Sending / anti-ban defaults (per instance, overridable per org) ----------
SEND_MIN_DELAY_MS=6000
SEND_MAX_DELAY_MS=20000
SEND_MAX_PER_MINUTE=6
SEND_MAX_PER_DAY=500
SEND_BATCH_SIZE=50
SEND_BATCH_COOLDOWN_MS=300000
SEND_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=5

# ---------- Backups ----------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ---------- Admin web ----------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
